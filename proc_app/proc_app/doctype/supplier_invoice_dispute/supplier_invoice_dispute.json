{
  "name": "Supplier Invoice Dispute",
  "doctype": "DocType",
  "module": "Proc App",
  "autoname": "naming_series:",
  "naming_series": "DISP-.YYYY.-",
  "is_submittable": 0,
  "track_changes": 1,
  "fields": [
    {"fieldname": "naming_series", "fieldtype": "Select", "label": "Series", "options": "DISP-.YYYY.-"},
    {"fieldname": "purchase_invoice", "fieldtype": "Link", "options": "Purchase Invoice", "label": "Purchase Invoice", "reqd": 1, "in_list_view": 1},
    {"fieldname": "supplier", "fieldtype": "Link", "options": "Supplier", "label": "Supplier", "reqd": 1},
    {"fieldname": "dispute_type", "fieldtype": "Select", "label": "Dispute Type", "reqd": 1, "options": "Wrong Amount\nMissing Items\nTax Issue\nDuplicate Invoice\nOther"},
    {"fieldname": "description", "fieldtype": "Long Text", "label": "Description", "reqd": 1},
    {"fieldname": "status", "fieldtype": "Select", "label": "Status", "options": "Open\nUnder Review\nResolved\nRejected", "default": "Open", "in_list_view": 1},
    {"fieldname": "resolution_note", "fieldtype": "Text", "label": "Resolution Note"},
    {"fieldname": "submitted_on", "fieldtype": "Datetime", "label": "Submitted On", "read_only": 1}
  ],
  "permissions": [
    {"role": "Supplier Portal User", "read": 1, "write": 1, "create": 1},
    {"role": "Purchase Manager", "read": 1, "write": 1, "create": 1},
    {"role": "Purchase User", "read": 1},
    {"role": "System Manager", "read": 1, "write": 1, "create": 1, "delete": 1}
  ]
}
